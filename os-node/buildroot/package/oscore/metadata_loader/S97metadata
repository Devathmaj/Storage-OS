#!/bin/sh
#
# S97metadata - Start metadata loader service
#
# This service must start after:
# - S40network (networking)
# - S90osstorage (storage server)
# - S95httpd (http server)

DAEMON=/usr/bin/metadata_loader
PID_FILE=/var/run/metadata_loader.pid
LOG_FILE=/var/log/metadata_loader.log
CACHE_DIR=/var/cache

start() {
    echo "Starting metadata loader service..."
    
    # Ensure cache directory exists
    mkdir -p "$CACHE_DIR"
    
    # Check if storage is mounted
    if ! mount | grep -q "/data"; then
        echo "Warning: Storage not mounted, metadata loader may not find files"
    fi
    
    # Check if already running
    if [ -f "$PID_FILE" ]; then
        PID=$(cat "$PID_FILE")
        if kill -0 "$PID" 2>/dev/null; then
            echo "Metadata loader is already running (PID $PID)"
            return 0
        else
            rm -f "$PID_FILE"
        fi
    fi
    
    # Start the daemon
    "$DAEMON" &
    
    # Wait a moment and check if it started
    sleep 2
    if [ -f "$PID_FILE" ]; then
        PID=$(cat "$PID_FILE")
        if kill -0 "$PID" 2>/dev/null; then
            echo "Metadata loader started successfully (PID $PID)"
            return 0
        fi
    fi
    
    echo "Failed to start metadata loader"
    return 1
}

stop() {
    echo "Stopping metadata loader service..."
    
    if [ ! -f "$PID_FILE" ]; then
        echo "Metadata loader is not running"
        return 0
    fi
    
    PID=$(cat "$PID_FILE")
    
    # Send SIGTERM for graceful shutdown
    if kill -0 "$PID" 2>/dev/null; then
        kill -TERM "$PID"
        
        # Wait up to 10 seconds for graceful shutdown
        for i in $(seq 1 10); do
            if ! kill -0 "$PID" 2>/dev/null; then
                echo "Metadata loader stopped"
                rm -f "$PID_FILE"
                return 0
            fi
            sleep 1
        done
        
        # Force kill if still running
        echo "Forcing metadata loader to stop..."
        kill -KILL "$PID" 2>/dev/null
        rm -f "$PID_FILE"
        return 0
    else
        echo "Metadata loader is not running"
        rm -f "$PID_FILE"
        return 0
    fi
}

restart() {
    stop
    sleep 1
    start
}

status() {
    if [ -f "$PID_FILE" ]; then
        PID=$(cat "$PID_FILE")
        if kill -0 "$PID" 2>/dev/null; then
            echo "Metadata loader is running (PID $PID)"
            
            # Show memory usage if available
            if [ -f "/proc/$PID/status" ]; then
                MEM=$(grep VmRSS /proc/$PID/status | awk '{print $2 " " $3}')
                echo "Memory usage: $MEM"
            fi
            
            # Show file count from log
            if [ -f "$LOG_FILE" ]; then
                FILES=$(grep "Index ready:" "$LOG_FILE" | tail -1 | grep -oP '\d+(?= files)')
                if [ -n "$FILES" ]; then
                    echo "Files indexed: $FILES"
                fi
            fi
            return 0
        else
            echo "Metadata loader is not running (stale PID file)"
            return 1
        fi
    else
        echo "Metadata loader is not running"
        return 1
    fi
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        restart
        ;;
    status)
        status
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

exit $?
