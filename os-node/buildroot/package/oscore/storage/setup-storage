#!/bin/sh
################################################################################
# setup-storage - Initial Storage Quota Setup (v4 - No Partition, Quota-Only)
################################################################################

DATA_MOUNT=/data
QUOTA_FILE=/etc/storage-quota.conf
DEVICE=/dev/vdb

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

clear

echo ""
echo "════════════════════════════════════════════════════════════════"
echo "           StorageOS - Initial Storage Configuration"
echo "                 (Quota-Based, No Partitioning)"
echo "════════════════════════════════════════════════════════════════"
echo ""

# Check if already configured
if [ -f "$QUOTA_FILE" ]; then
    echo "✓ Storage quota already configured."
    echo ""
    cat "$QUOTA_FILE"
    echo ""
    echo "Run 'storagemgr status' to check current usage."
    echo "Run 'storagemgr set <MB>' to change quota."
    echo ""
    exit 0
fi

# Get disk size (either from mounted filesystem or raw device)
DISK_SIZE_MB=0
if mountpoint -q "$DATA_MOUNT" 2>/dev/null; then
    # Get size from mounted filesystem
    DISK_SIZE_MB=$(df -m "$DATA_MOUNT" 2>/dev/null | tail -1 | awk '{print $2}')
elif [ -b "$DEVICE" ]; then
    # Get size from raw device
    DISK_SIZE_BYTES=$(blockdev --getsize64 "$DEVICE" 2>/dev/null)
    DISK_SIZE_MB=$((DISK_SIZE_BYTES / 1024 / 1024))
fi

if [ "$DISK_SIZE_MB" -eq 0 ] || [ -z "$DISK_SIZE_MB" ]; then
    echo "${RED}✗ Error: Could not detect storage device size${NC}"
    echo "  Device: $DEVICE"
    echo "  Mount Point: $DATA_MOUNT"
    exit 1
fi

echo "📊 Storage Device Information:"
echo "─────────────────────────────────────────────────────────────────"
echo "  Device:              $DEVICE"
echo "  Total Capacity:      ${DISK_SIZE_MB} MB ($(echo "scale=2; $DISK_SIZE_MB/1024" | bc 2>/dev/null || echo "$((DISK_SIZE_MB/1024))") GB)"
echo "─────────────────────────────────────────────────────────────────"
echo ""
echo "This system uses quota-based storage management."
echo "Storage starts at 0 and grows as files are added, up to your quota."
echo "If the physical disk fills up, new files will be rejected."
echo ""

# Calculate recommended quota (80% of disk to leave some headroom)
RECOMMENDED_MB=$((DISK_SIZE_MB * 80 / 100))
if [ "$RECOMMENDED_MB" -lt 100 ]; then
    RECOMMENDED_MB=100
fi

echo "Maximum allowed quota: ${DISK_SIZE_MB} MB"
echo "Recommended quota:     ${RECOMMENDED_MB} MB (80% of disk)"
echo ""

# Prompt for quota
while true; do
    echo -n "Enter storage quota in MB (1-${DISK_SIZE_MB}, default ${RECOMMENDED_MB}): "
    read QUOTA_INPUT
    
    # Use recommended if empty
    if [ -z "$QUOTA_INPUT" ]; then
        QUOTA_LIMIT_MB="$RECOMMENDED_MB"
        break
    fi
    
    # Validate input
    if ! echo "$QUOTA_INPUT" | grep -qE '^[0-9]+$'; then
        echo "${RED}✗ Invalid input. Please enter a number.${NC}"
        echo ""
        continue
    fi
    
    QUOTA_LIMIT_MB="$QUOTA_INPUT"
    
    if [ "$QUOTA_LIMIT_MB" -lt 1 ]; then
        echo "${RED}✗ Minimum quota is 1 MB.${NC}"
        echo ""
        continue
    fi
    
    if [ "$QUOTA_LIMIT_MB" -gt "$DISK_SIZE_MB" ]; then
        echo "${RED}✗ Quota (${QUOTA_LIMIT_MB}MB) exceeds disk capacity (${DISK_SIZE_MB}MB)${NC}"
        echo "  Please enter a value up to ${DISK_SIZE_MB} MB."
        echo ""
        continue
    fi
    
    break
done

echo ""
echo "════════════════════════════════════════════════════════════════"
echo "           Configuring Storage Quota..."
echo "════════════════════════════════════════════════════════════════"
echo ""

# Save quota configuration
echo "→ Saving quota configuration..."
cat > "$QUOTA_FILE" <<EOF
# Storage Quota Configuration
# Created: $(date)
# 
# This file controls the maximum storage usage for this node.
# Storage grows dynamically as files are added, up to QUOTA_LIMIT_MB.
# If physical disk space runs out before quota, new files are rejected.
#
QUOTA_LIMIT_MB=$QUOTA_LIMIT_MB
DISK_SIZE_MB=$DISK_SIZE_MB
CURRENT_USAGE_MB=0
SETUP_COMPLETED=yes
EOF

if [ -f "$QUOTA_FILE" ]; then
    echo "${GREEN}✓ Quota configuration saved${NC}"
else
    echo "${RED}✗ Failed to save configuration${NC}"
    exit 1
fi
echo ""

echo "════════════════════════════════════════════════════════════════"
echo "           ${GREEN}✓ Storage Configuration Complete!${NC}"
echo "════════════════════════════════════════════════════════════════"
echo ""
echo "📊 Storage Quota Summary:"
echo "─────────────────────────────────────────────────────────────────"
echo "  Disk Capacity:       ${DISK_SIZE_MB} MB"
echo "  Quota Limit:         ${QUOTA_LIMIT_MB} MB"
echo "  Current Usage:       0 MB"
echo "  Available:           ${QUOTA_LIMIT_MB} MB"
echo "─────────────────────────────────────────────────────────────────"
echo ""
echo "Storage behavior:"
echo "  • Files are stored in: $DATA_MOUNT"
echo "  • Storage grows as files are added (no pre-allocation)"
echo "  • New files rejected when quota (${QUOTA_LIMIT_MB} MB) is reached"
echo "  • New files rejected if physical disk fills up"
echo ""
echo "Commands:"
echo "  storagemgr status    - Check current usage"
echo "  storagemgr set <MB>  - Change quota (up to ${DISK_SIZE_MB} MB)"
echo ""
echo "Press Enter to continue..."
read

exit 0
